# ---- LLM（OpenAI 兼容接口，可接 DeepSeek/Qwen/GLM 等）----
LLM_API_KEY=
LLM_BASE_URL=
LLM_CHEAP_MODEL=
LLM_STRONG_MODEL=

# ---- 图像生成 API（火山方舟 / 即梦 Seedream）----
IMAGE_PROVIDER=seedream
IMAGE_API_KEY=
IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
IMAGE_MODEL_T2I=doubao-seedream-5-0-pro-260628
IMAGE_MODEL_I2I=doubao-seedream-5-0-pro-260628
IMAGE_SIZE=1K

# ---- TTS（火山引擎豆包语音合成）----
TTS_PROVIDER=volcengine
TTS_API_KEY=
TTS_API_BASE=openspeech.bytedance.com
TTS_RESOURCE_ID=seed-tts-2.0
TTS_NARRATOR_SPEAKER=zh_female_vv_uranus_bigtts
TTS_CHARACTER_SPEAKERS=

# ---- ASR（Whisper 兼容 /audio/transcriptions，可暂不配）----
ASR_PROVIDER=whisper
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=whisper-1

# ---- 本地数据目录（可选，默认 ./data）----
# NOVEL_CINEMA_DATA_DIR=./data
